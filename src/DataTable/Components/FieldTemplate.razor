@typeparam T
@implements IDisposable

@using System.Linq.Expressions
@using Avolutions.Baf.Core.Lists
@using MudBlazor

@code {
    [CascadingParameter] public DataTable<T>? Parent { get; set; }

    [Parameter] public required Expression<Func<T, object?>> For { get; set; }

    [Parameter] public required RenderFragment<CellContext<T>> ChildContent { get; set; }

    private string _path = string.Empty;

    protected override void OnInitialized()
    {
        if (Parent is null)
        {
            throw new InvalidOperationException($"{nameof(FieldTemplate<T>)} must be placed inside a {nameof(DataTable<T>)}.");
        }

        _path = PropertyPath.From(For);

        Parent.RegisterTemplate(_path, ChildContent);
    }

    public void Dispose()
    {
        Parent?.UnregisterTemplate(_path);
    }
}