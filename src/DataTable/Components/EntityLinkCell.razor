@typeparam T where T : class, IEntity
@using Avolutions.Baf.Blazor.LockStatus.Components
@using Avolutions.Baf.Core.Entity.Abstractions
@using MudBlazor

@inject IEntityRouteProvider<T> Routes

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
    <LinkCell Href="@Routes.Details(Entity.Id)">
        @Entity.GetName()
    </LinkCell>
    @if (Entity is ILockable lockable)
    {
        <LockStatusChip Status="@lockable.LockStatus" IconOnly="true"/>
    }
</MudStack>

@code {
    [Parameter] public required T Entity { get; set; }
}